{
  "name": "tabby-workspaces",
  "version": "0.2.0",
  "description": "Chrome-style workspaces for Tabby: one window per workspace, with named pinned tabs that come back where you left them",
  "keywords": [
    "tabby-plugin",
    "tabby",
    "workspaces",
    "pinned-tabs",
    "wsl",
    "tmux"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "Darko Poposki",
  "homepage": "https://github.com/dpoposki/tabby-workspaces#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dpoposki/tabby-workspaces.git"
  },
  "bugs": {
    "url": "https://github.com/dpoposki/tabby-workspaces/issues"
  },
  "devDependencies": {
    "@angular/common": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@angular/platform-browser": "^15.2.10",
    "@ng-bootstrap/ng-bootstrap": "^14.2.0",
    "@types/node": "^20.19.43",
    "rxjs": "^7.8.2",
    "tabby-core": "^1.0.231-nightly.0",
    "ts-loader": "^9.6.2",
    "tslib": "^2.9.1",
    "typescript": "4.9",
    "vitest": "^3.2.4",
    "webpack": "^5.112.2",
    "webpack-cli": "^5.1.4"
  }
}
