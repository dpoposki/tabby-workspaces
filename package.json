{
  "name": "tabby-workspaces",
  "version": "0.1.0",
  "description": "Chrome-like workspaces for Tabby: one window per workspace, named pinned tabs restored on open",
  "keywords": [
    "tabby-plugin"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit -p ."
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "devDependencies": {
    "@angular/common": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@angular/platform-browser": "^15.2.10",
    "@ng-bootstrap/ng-bootstrap": "^14.2.0",
    "@types/node": "^20.19.43",
    "rxjs": "^7.8.2",
    "tabby-core": "^1.0.231-nightly.0",
    "ts-loader": "^9.6.2",
    "tslib": "^2.9.1",
    "typescript": "4.9",
    "webpack": "^5.112.2",
    "webpack-cli": "^5.1.4"
  }
}
