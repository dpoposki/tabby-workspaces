{
  "compilerOptions": {
    "module": "es2015",
    "target": "es2017",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "importHelpers": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "lib": ["DOM", "ES2021"],
    "types": []
  },
  "include": ["src"]
}
